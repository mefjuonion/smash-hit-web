# Stage 1: Build
FROM node:22.21.1-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

ARG VITE_WS_URL

RUN pnpm run build

# Stage 2: Runtime
FROM node:22.21.1-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.25.0 --activate && pnpm add -g serve@14

COPY --from=build /app/dist ./dist

EXPOSE 8080

CMD ["serve", "-s", "dist", "-l", "8080"]
