# Stage 1: Build
FROM node:22.21.1-alpine AS build

WORKDIR /app

RUN npm install -g corepack@latest && corepack enable

# Copy full project structure so rootDir ("..") resolves correctly
COPY server/ ./server/
# Create shared dir (may not exist but tsconfig references it)
RUN mkdir -p ./shared

WORKDIR /app/server

RUN pnpm install --frozen-lockfile

RUN pnpm run build

# Stage 2: Runtime
FROM node:22.21.1-alpine

WORKDIR /app

RUN npm install -g corepack@latest && corepack enable

COPY --from=build /app/server/package.json /app/server/pnpm-lock.yaml /app/server/pnpm-workspace.yaml ./

RUN pnpm install --prod --frozen-lockfile

COPY --from=build /app/server/dist ./dist

EXPOSE 8080

ENV NODE_ENV=production

# tsc with rootDir=".." outputs to dist/server/
CMD ["node", "dist/server/index.js"]
